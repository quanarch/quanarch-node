/**
 * The quan's own process. The quanar starts one per quan with the permission model on and an
 * empty environment: no file system, no child processes, no workers, no native addons.
 * This file is quanar code; the quan arrives as text and only sees the quas plugged into it.
 */
import vm from 'node:vm';
[[ range .Quas ]]import * as [[ pascal .Name ]] from '[[ .Name ]]';
[[ end ]]// qu:qua-imports
import type { FromQuan, Handler, HttpMethod, Listen, ToQuan } from '../types';

const send = (message: FromQuan) => process.send!(message);
const errorText = (error: unknown) => (error instanceof Error ? error.message : String(error));

// ---- capability calls go back to the quanar ----

let nextCall = 0;
const pending = new Map<number, { resolve: (v: unknown) => void; reject: (e: Error) => void }>();

function call(capability: string, args: unknown[]): Promise<any> {
  const id = ++nextCall;
  return new Promise((resolve, reject) => {
    pending.set(id, { resolve, reject });
    send({ type: 'call', id, capability, args });
  });
}

// ---- listening: the handler stays here, the quanar only learns the method and the path ----

const handlers: Handler[] = [];
const listens: Listen[] = [];

function listen(method: HttpMethod) {
  return (path: string, handler: Handler) => {
    handlers.push(handler);
    listens.push({ method, path });
  };
}

/**
 * The core this host plugs into a qua: listening stays here, everything else goes to the quanar.
 * Each qua's QuanarCore must have this shape; give a qua with other capabilities its own core.
 */
function coreFor(qua: string) {
  return {
    api: { get: listen('GET'), post: listen('POST'), put: listen('PUT'), patch: listen('PATCH'), delete: listen('DELETE') },
    db: {
      create: (table: string, data: Record<string, unknown>) => call(`${qua}:db.create`, [table, data]),
      list: (table: string) => call(`${qua}:db.list`, [table]),
      get: (table: string, id: string) => call(`${qua}:db.get`, [table, id]),
      update: (table: string, id: string, data: Record<string, unknown>) => call(`${qua}:db.update`, [table, id, data]),
      remove: (table: string, id: string) => call(`${qua}:db.remove`, [table, id]),
    },
  };
}

/** Every qua this host can plug. Lines marked "qu:" are where `qu` adds a qua when a new quan brings one. */
const QUAS: Record<string, { module: unknown; plug: () => void }> = {
[[- range .Quas ]]
  '[[ .Name ]]': { module: [[ pascal .Name ]], plug: () => [[ pascal .Name ]].init(coreFor('[[ .Name ]]')) },
[[- end ]]
  // qu:qua-host
};

// ---- walls the permission model does not cover ----

function closeWalls() {
  // Where the quanar lives on disk is none of the quan's business.
  for (const name of ['mainModule', 'argv', 'execArgv', 'execPath'] as const) {
    Object.defineProperty(process, name, { value: undefined, configurable: false });
  }
  const blocked = new Set(['net', 'http', 'https', 'http2', 'tls', 'dgram', 'dns', 'fs', 'child_process', 'worker_threads', 'cluster', 'vm', 'inspector', 'module', 'repl']);
  const original = process.getBuiltinModule.bind(process);
  process.getBuiltinModule = ((id: string) => {
    if (blocked.has(id.replace(/^node:/, ''))) throw new Error(`"${id}" is not available to quans`);
    return original(id);
  }) as typeof process.getBuiltinModule;
  for (const name of ['fetch', 'WebSocket', 'EventSource', 'Request', 'Response', 'Headers', 'FormData']) {
    delete (globalThis as Record<string, unknown>)[name];
  }
}

// ---- the quan ----

let onUnmount: (() => unknown) | undefined;

function load(name: string, code: string, quas: string[]) {
  for (const qua of quas) QUAS[qua]?.plug();
  closeWalls();

  const quanRequire = (id: string): unknown => {
    if (quas.includes(id) && QUAS[id]) return QUAS[id].module;
    throw new Error(`${name} asked for "${id}", but it is not plugged in. Plugged: ${quas.join(', ') || 'nothing'}`);
  };

  const module = { exports: {} as Record<string, unknown> };
  vm.compileFunction(code, ['exports', 'require', 'module'], { filename: `quan:${name}` })(module.exports, quanRequire, module);
  onUnmount = module.exports.onUnmount as typeof onUnmount;
}

process.on('message', async (message: ToQuan) => {
  switch (message.type) {
    case 'load':
      try {
        load(message.name, message.code, message.quas);
        send({ type: 'loaded', listens });
      } catch (error) {
        send({ type: 'load-failed', error: errorText(error) });
      }
      return;

    case 'request':
      try {
        const res = await handlers[message.route](message.req);
        send({ type: 'response', id: message.id, res });
      } catch (error) {
        send({ type: 'response', id: message.id, error: errorText(error) });
      }
      return;

    case 'result': {
      const waiting = pending.get(message.id);
      pending.delete(message.id);
      if (message.error) waiting?.reject(new Error(message.error));
      else waiting?.resolve(message.value);
      return;
    }

    case 'unmount':
      try {
        await onUnmount?.();
      } finally {
        process.exit(0);
      }
  }
});

// A quan that throws where nobody catches it takes down only its own process.
process.on('uncaughtException', (error) => {
  send({ type: 'log', level: 'error', message: `crashed: ${error.message}` });
  process.exit(1);
});
process.on('unhandledRejection', (reason) => {
  send({ type: 'log', level: 'error', message: `crashed: ${errorText(reason)}` });
  process.exit(1);
});
